def buscar_materias_por_ubicacion(horarios, ubicacion_buscada):
    "Busca eventos que coincidan o contengan una ubicación específica"
    resultados = []
    ubicacion_buscada = limpiar_texto(ubicacion_buscada)
    
    for evento in horarios:
        ubicacion_evento = limpiar_texto(evento.get("ubicacion", ""))
        
        # Usamos 'in' para que sea flexible (ej: buscar 'aula' encuentre 'Aula 101')
        if ubicacion_buscada in ubicacion_evento:
            resultados.append({
                "estudiante": evento["estudiante"],
                "materia": evento["materia"],
                "dia": evento["dia"],
                "hora": f"{evento['hora_inicio']} - {evento['hora_fin']}"
            })
            
    return resultados