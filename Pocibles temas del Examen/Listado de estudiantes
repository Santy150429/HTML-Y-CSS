def obtener_estudiantes_registrados(horarios):
    "Devuelve una lista con los nombres únicos de los estudiantes registrados en el sistema"
    nombres_unicos = []
    
    for evento in horarios:
        estudiante = evento.get("estudiante", "").strip()
        
        # Verificamos si ya está en la lista (ignorando mayúsculas/minúsculas)
        encontrado = False
        for n in nombres_unicos:
            if n.lower() == estudiante.lower():
                encontrado = True
                break
                
        if not encontrado and estudiante:
            nombres_unicos.append(estudiante)
            
    return nombres_unicos