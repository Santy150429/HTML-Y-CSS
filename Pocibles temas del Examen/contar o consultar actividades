def contar_materias_por_dia(horarios, estudiante, dia):
    "Cuenta cuántas actividades tiene un estudiante en un día específico de la semana"
    # Validamos que el día sea correcto usando una función que ya existe en tu código
    if not dia_valido(dia):
        return 0, f"El día '{dia}' no es válido."
    
    contador = 0
    estudiante_buscado = limpiar_texto(estudiante)
    dia_buscado = limpiar_texto(dia)
    
    for evento in horarios:
        if (limpiar_texto(evento.get("estudiante", "")) == estudiante_buscado and 
            limpiar_texto(evento.get("dia", "")) == dia_buscado):
            contador += 1
            
    return contador, f"El estudiante {estudiante} tiene {contador} actividad(es) el día {dia.capitalize()}."