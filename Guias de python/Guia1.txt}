import csv
import json


def json_a_csv():
  with open("horarios.json", "r", encoding="utf-8") as f:
    datos = json.load(f)

  with open("horarios.csv", "w", newline="", encoding="utf-8") as f:
    escritor = csv.writer(f)
    # Escribir encabezados
    escritor.writerow(
        ["Estudiante", "Materia", "Día", "Inicio", "Fin", "Ubicación"]
    )
    # Escribir filas
    for e in datos:
      escritor.writerow([
          e.get("estudiante"),
          e.get("materia"),
          e.get("dia"),
          e.get("hora_inicio"),
          e.get("hora_fin"),
          e.get("ubicacion"),
      ])
  print("¡Exportado a CSV con éxito!")

