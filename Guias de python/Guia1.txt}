#7. Eliminar a un estudiante completo de una sola vez
#Borra todas las materias asociadas a un estudiante específico del archivo JSON de golpe.

def eliminar_estudiante_completo(estudiante):
  with open("horarios.json", "r", encoding="utf-8") as f:
    horarios = json.load(f)

  # Filtrar para dejar solo los que NO sean de ese estudiante
  nuevos_horarios = [
      e
      for e in horarios
      if e.get("estudiante", "").lower() != estudiante.lower()
  ]

  with open("horarios.json", "w", encoding="utf-8") as f:
    json.dump(nuevos_horarios, f, indent=4, ensure_ascii=False)
  print(f"Estudiante {estudiante} y todas sus materias fueron eliminados.")

