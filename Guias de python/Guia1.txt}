def limpiar_texto(texto):
  "Convierte a minúsculas, elimina espacios extras y remueve tildes"
  texto = texto.lower().strip()
  reemplazos = (("á", "a"), ("é", "e"), ("í", "i"), ("ó", "o"), ("ú", "u"))
  for origen, destino in reemplazos:
