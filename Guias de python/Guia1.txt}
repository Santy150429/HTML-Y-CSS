#9. Buscar materias por ubicación o salón
#Filtra rápidamente qué clases se dictan en un salón o edificio en específico.

def buscar_por_ubicacion(horarios, lugar):
  return [
      e
      for e in horarios
      if lugar.lower() in e.get("ubicacion", "").lower()
  ]

