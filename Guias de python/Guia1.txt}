#2. Buscar materias por profesor
#Si agregaste el campo "profesor" a tu JSON, esta función te permite filtrar todas las clases impartidas por un docente específico.

def buscar_por_profesor(horarios, nombre_profesor):
  encontradas = [
      e
      for e in horarios
      if e.get("profesor", "").lower() == nombre_profesor.lower()
  ]
  return encontradas

#3. Calcular las horas totales de clase a la semana
#Suma cuántas horas pasa un estudiante en clase calculando la diferencia entre la hora de inicio y de fin.

def calcular_horas_totales(horarios, estudiante):
  total_minutos = 0
  for e in horarios:
    if e.get("estudiante", "").lower() == estudiante.lower():
      # Usando tu función horas_a_minutos previa
      inicio = horas_a_minutos(e["hora_inicio"])
      fin = horas_a_minutos(e["hora_fin"])
      if inicio != -1 and fin != -1:
        total_minutos += fin - inicio
  return total_minutos / 60  # Devuelve las horas en formato decimal

