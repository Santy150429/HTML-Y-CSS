#Reorganiza todo tu archivo JSON para que las materias queden ordenadas de la A a la Z.

import json


def ordenar_json_alfabeticamente():
  with open("horarios.json", "r", encoding="utf-8") as f:
    horarios = json.load(f)

  # Ordenar por nombre de materia
  horarios_ordenados = sorted(horarios, key=lambda x: x["materia"])

  with open("horarios.json", "w", encoding="utf-8") as f:
